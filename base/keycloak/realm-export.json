{
  "realm": "sapfire",
  "displayName": "Sapfire Manager",
  "loginTheme": "sapfire",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "sapfire-admin",    "description": "Org admin in any Sapfire org" },
      { "name": "sapfire-employee", "description": "Regular employee in any Sapfire org" }
    ]
  },
  "groups": [
    {
      "name": "orgs",
      "subGroups": [
        {
          "name": "acme",
          "attributes": { "org-slug": ["acme"] },
          "subGroups": [
            {
              "name": "roles",
              "subGroups": [
                { "name": "admin",    "realmRoles": ["sapfire-admin"] },
                { "name": "employee", "realmRoles": ["sapfire-employee"] }
              ]
            }
          ]
        },
        {
          "name": "beta",
          "attributes": { "org-slug": ["beta"] },
          "subGroups": [
            {
              "name": "roles",
              "subGroups": [
                { "name": "admin",    "realmRoles": ["sapfire-admin"] },
                { "name": "employee", "realmRoles": ["sapfire-employee"] }
              ]
            }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "sapfire-spa",
      "name": "Sapfire SPA",
      "description": "Public OIDC client for the React SPA. Auth Code + PKCE, no secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "https://localhost/*",
        "https://app.dev.sapfire.test/*",
        "https://app.sapfire.test/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "https://localhost",
        "https://app.dev.sapfire.test",
        "https://app.sapfire.test"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*##https://localhost/*##https://app.dev.sapfire.test/*##https://app.sapfire.test/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "roles"
          }
        },
        {
          "name": "audience-sapfire-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sapfire-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sapfire-api",
      "name": "Sapfire API (resource server + admin client)",
      "description": "Confidential client used by the ASP.NET server to (a) be the audience of access tokens and (b) call the Keycloak Admin REST API via its service account.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me-in-real-deployments",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "use.refresh.tokens": "false"
      }
    },
    {
      "clientId": "sapfire-seed",
      "name": "Sapfire seed / demo client (direct grant)",
      "description": "Public client with Direct Access Grants enabled, used by deploy/seed.sh and manual testing to obtain real user tokens (username+password) for the demo accounts. The SPA client keeps direct grants disabled; this one exists only to script/seed demo data.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "roles"
          }
        },
        {
          "name": "audience-sapfire-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sapfire-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-sapfire-api",
      "enabled": true,
      "serviceAccountClientId": "sapfire-api",
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "view-users",
          "query-users",
          "query-groups",
          "manage-users"
        ]
      }
    },
    {
      "username": "acme-admin",
      "email": "admin@acme.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "demo1234", "temporary": false } ],
      "groups": [ "/orgs/acme/roles/admin" ]
    },
    {
      "username": "acme-emp1",
      "email": "emp1@acme.test",
      "firstName": "Erin",
      "lastName": "Employee",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "demo1234", "temporary": false } ],
      "groups": [ "/orgs/acme/roles/employee" ]
    },
    {
      "username": "acme-emp2",
      "email": "emp2@acme.test",
      "firstName": "Evan",
      "lastName": "Employee",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "demo1234", "temporary": false } ],
      "groups": [ "/orgs/acme/roles/employee" ]
    },
    {
      "username": "acme-emp3",
      "email": "emp3@acme.test",
      "firstName": "Ola",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "demo1234", "temporary": false } ],
      "groups": [ "/orgs/acme/roles/employee" ]
    },
    {
      "username": "beta-admin",
      "email": "admin@beta.test",
      "firstName": "Boris",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "demo1234", "temporary": false } ],
      "groups": [ "/orgs/beta/roles/admin" ]
    }
  ]
}
